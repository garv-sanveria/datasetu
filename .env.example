# DataSetu Environment Configuration (Example)
# Copy to .env for local overrides if needed

# Server Host and Port
DATASETU_HOST=127.0.0.1
DATASETU_PORT=8000

# Polling Interval in Seconds for CDC Worker
DATASETU_POLL_INTERVAL=30

# Optional Local AI Assistant (Ollama endpoint on localhost)
# Disabled by default; core pipeline is 100% deterministic
DATASETU_OLLAMA_URL=http://localhost:11434
DATASETU_OLLAMA_MODEL=gemma2:2b
